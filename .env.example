# Copy this file to .env. Never commit or share real values.
# Professional Instagram account ID (not the Meta app or portfolio ID).
INSTAGRAM_USER_ID=
# Access token for the login mode selected in config.toml.
INSTAGRAM_ACCESS_TOKEN=
# Required for public media hosting when publishing for real.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Required only when ai.provider = "openai" and ai.enabled = true.
OPENAI_API_KEY=
